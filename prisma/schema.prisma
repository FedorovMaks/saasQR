generator client {
  provider      = "prisma-client-js"
  output        = "../src/generated/prisma"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ───── AUTH ─────

enum Plan {
  BASIC
  BUSINESS
  PRO
}

model User {
  id             String    @id @default(cuid())
  email          String    @unique
  hashedPassword String
  name           String?
  plan           Plan      @default(BASIC)
  planExpiresAt  DateTime?
  trialEndsAt    DateTime?
  isSuperAdmin   Boolean   @default(false)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  venues            Venue[]
  accounts          Account[]
  sessions          Session[]
  pushSubscriptions PushSubscription[]
  staffRoles        Staff[]

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ───── VENUE & MENU ─────

model Venue {
  id          String   @id @default(cuid())
  ownerId     String
  name        String
  slug        String   @unique
  description String?  @db.Text
  address     String?
  logoUrl     String?
  currency    String   @default("RUB")
  accentColor String   @default("#2563eb")
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // YooKassa per-venue payment credentials
  yookassaShopId    String?
  yookassaSecretKey String?

  owner        User          @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  categories   Category[]
  orders       Order[]
  tables       Table[]
  staff        Staff[]
  staffInvites StaffInvite[]

  @@index([ownerId])
  @@map("venues")
}

model Category {
  id        String   @id @default(cuid())
  venueId   String
  name      String
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  venue Venue      @relation(fields: [venueId], references: [id], onDelete: Cascade)
  items MenuItem[]

  @@index([venueId])
  @@map("categories")
}

model MenuItem {
  id          String   @id @default(cuid())
  categoryId  String
  name        String
  description String?  @db.Text
  price       Int
  imageUrl    String?
  isStopped   Boolean  @default(false)
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Nutrition info (КБЖУ) — per serving
  calories    Int?     // kcal
  proteins    Float?   // grams
  fats        Float?   // grams
  carbs       Float?   // grams

  // Ingredients / composition
  composition String?  @db.Text

  category   Category      @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  variants   MenuVariant[]
  orderItems OrderItem[]

  @@index([categoryId])
  @@map("menu_items")
}

model MenuVariant {
  id         String @id @default(cuid())
  menuItemId String
  label      String
  price      Int
  sortOrder  Int    @default(0)

  menuItem   MenuItem    @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  orderItems OrderItem[]

  @@index([menuItemId])
  @@map("menu_variants")
}

// ───── ORDERS ─────

enum OrderStatus {
  NEW
  ACCEPTED
  PREPARING
  READY
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  PENDING
  PAID
  REFUNDED
}

model Order {
  id            String        @id @default(cuid())
  venueId       String
  orderNumber   Int
  tableNumber   String?
  status        OrderStatus   @default(NEW)
  paymentStatus PaymentStatus @default(UNPAID)
  paymentId     String?       // YooKassa payment ID
  comment       String?       @db.Text
  totalAmount   Int
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  venue Venue       @relation(fields: [venueId], references: [id], onDelete: Cascade)
  items OrderItem[]

  @@index([venueId, status])
  @@index([venueId, createdAt])
  @@map("orders")
}

model OrderItem {
  id           String  @id @default(cuid())
  orderId      String
  menuItemId   String
  variantId    String?
  quantity     Int
  priceAtOrder Int
  itemName     String
  variantLabel String?

  order    Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItem MenuItem     @relation(fields: [menuItemId], references: [id])
  variant  MenuVariant? @relation(fields: [variantId], references: [id])

  @@index([orderId])
  @@map("order_items")
}

// ───── TABLES & QR ─────

model Table {
  id        String  @id @default(cuid())
  venueId   String
  number    String
  qrCodeUrl String?

  venue Venue @relation(fields: [venueId], references: [id], onDelete: Cascade)

  @@unique([venueId, number])
  @@map("tables")
}

// ───── STAFF (WAITERS) ─────

model Staff {
  id        String   @id @default(cuid())
  venueId   String
  userId    String
  role      String   @default("waiter") // waiter | manager (future)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  venue Venue @relation(fields: [venueId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([venueId, userId])
  @@index([venueId])
  @@index([userId])
  @@map("staff")
}

model StaffInvite {
  id        String   @id @default(cuid())
  venueId   String
  token     String   @unique @default(cuid())
  isUsed    Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())

  venue Venue @relation(fields: [venueId], references: [id], onDelete: Cascade)

  @@index([venueId])
  @@map("staff_invites")
}

// ───── PUSH SUBSCRIPTIONS ─────

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_subscriptions")
}
